# Replace every REPLACE_* value before starting Compose. Keep this file out of Git.
NOUS_ENQUEUER_IMAGE=ghcr.io/italo-jsm/nous-enqueuer:sha-REPLACE_WITH_COMMIT
RABBITMQ_BIND_IP=REPLACE_WITH_PRIVATE_HOST_IP

# Bootstrap account is administrative and is used only by rabbitmq-init.
RABBITMQ_BOOTSTRAP_USERNAME=REPLACE_WITH_BOOTSTRAP_USERNAME
RABBITMQ_BOOTSTRAP_PASSWORD=REPLACE_WITH_LONG_RANDOM_BOOTSTRAP_PASSWORD
# The application account has permissions only for ai.telegram.inbound in vhost ai.
RABBITMQ_USERNAME=nous_enqueuer
RABBITMQ_PASSWORD=REPLACE_WITH_LONG_RANDOM_APP_PASSWORD
